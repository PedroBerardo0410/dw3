{% extends "layout.njk" %}
{% block content %}
<section class="login-screen d-flex align-items-center justify-content-center">
  <div class="login-card card border-0">
    <div class="card-body p-4 p-md-5">
      <p class="page-kicker text-primary fw-semibold mb-2">DW3 Frontend</p>
      <h1 class="h3 fw-bold mb-2">Acesso ao sistema</h1>
      <p class="text-secondary mb-4">Entre para visualizar o painel e o menu principal.</p>
      {% if error %}<div id="loginError" class="alert alert-danger" role="alert">{{ error }}</div>{% else %}<div id="loginError" class="alert alert-danger d-none" role="alert"></div>{% endif %}
      <form id="loginForm" method="post" action="/login">
        <div class="mb-3">
          <label class="form-label" for="usuario">Usuário</label>
          <input class="form-control" id="usuario" name="usuario" type="text" placeholder="Seu usuário" autocomplete="username" required autofocus>
        </div>
        <div class="mb-4">
          <label class="form-label" for="senha">Senha</label>
          <input class="form-control" id="senha" name="senha" type="password" placeholder="Sua senha" autocomplete="current-password" required>
        </div>
        <button class="btn btn-primary w-100" type="submit">Entrar</button>
      </form>
    </div>
  </div>
</section>
<script src="/apps/login/vwLogin.js"></script>
<script src="/js/dw3frontend.js"></script>
{% endblock %}
